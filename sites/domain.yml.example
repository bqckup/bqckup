bqckup:
  name: domain
  enabled: no

  # ----------------------------------------------------------------------------
  # Incremental backup (powered by rustic)
  # ----------------------------------------------------------------------------
  # When enabled, file backups are stored as deduplicated, versioned snapshots
  # instead of a full .tar.gz archive on every run. Only changed data is written.
  #
  # Requirements:
  #   - The `rustic` binary must be installed on the host.
  #   - `password` is REQUIRED and is used to encrypt the repository. Keep it
  #     safe: losing it means the backup can no longer be restored.
  #
  # Where the repository lives is controlled by `options.provider` below:
  #   - provider: s3    -> repository is stored in the S3 bucket (options.storage)
  #   - provider: local -> repository is stored on this machine, under
  #                        `<options.save_locally_path>/<name>/incremental`
  #
  # Restore (safe):     bqckup restore <name> --target <dir>  (into a folder you choose)
  # Restore (in place): bqckup restore <name>                 (WARNS + confirms; OVERWRITES the original paths)
  #                     add --snapshot <id> to pick a specific snapshot
  # List snapshots:     bqckup get-list <name>
  incremental:
    enabled: yes
    password: dummy # required if incremental

  path:
    - /var/www/html
  exclude_path:
    - cache
  database:
    enabled: yes
    type: mysql
    host: localhost
    port: 3306
    user: root
    password: root
    name: database
  databases:
    - enabled: yes
      type: mysql
      host: localhost
      port: 3306
      user: root
      password: root
      name: database

  options:
    # --------------------------------------------------------------------------
    # provider: where backups are stored. Supported values: s3, local
    # --------------------------------------------------------------------------
    #
    # provider: s3
    #   Uploads backups to an S3-compatible bucket.
    #   - `storage` must reference a storage name defined in storages.yml.
    #   Works for both archive (.tar.gz) and incremental backups.
    #
    # provider: local
    #   Keeps backups on this machine, no S3 needed.
    #   - `save_locally_path` is the folder where everything is written
    #     (defaults to /etc/bqckup/tmp if left empty).
    #   - Archive backups go to:     <save_locally_path>/<name>/<date>/
    #   - Incremental backups go to: <save_locally_path>/<name>/incremental/
    #   - Database dumps go to:      <save_locally_path>/<name>/
    #   - `storage` is ignored (set automatically to "local").
    provider: s3

    # S3 storage name from storages.yml (only used when provider: s3)
    storage: dummy

    interval: daily #can be daily, weekly, monthly
    retention: '7' # how many snapshots/backups to keep before pruning old ones
    follow_symlink: no
    # For provider: s3  -> keep an extra local copy of the backup besides the S3 upload.
    # For provider: local -> this is the backup location itself.
    save_locally: no
    save_locally_path: /etc/bqckup/tmp
    notification_email: email@example.com
