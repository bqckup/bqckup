bqckup:
  name: domain
  path:
    - /var/www/html
  exclude_path:
    - /var/www/html/cache
  database:
    type: mysql
    host: localhost
    port: 3306
    user: root
    password: root
    name: database
  options:
    storage: dummy
    interval: daily #can be daily, weekly, yearly 
    retention: '7'
    disabled: true
    save_locally: no
    save_locally_path: /etc/bqckup/tmp
    notification_email: email@example.com
    provider: s3
