[web]
; Port to listen on for the web interface
port=9393

[auth]
; Authentication password for the web interface
password="bqckup"

[bqckup]
; Backup the configuration
config_backup=1

; Default storage name
root_folder_name=bqckup

; To understand how Bqckup performs in various environments by contributing anonymous statistics. This will enable us to identify any issues that may occur with specific distributions or setups and improve our analysis of the data.
anonymous_statistic=1

[notification]
; Master switch for ALL notifications (1 = on, 0 = off)
enabled=0

; Send a monthly report at the end of every month (requires enabled=1)
monthly_report_enabled=0

; Which channels to send to. Comma separated. Supported: discord, email, webhook
;   channel=discord        -> only Discord
;   channel=email          -> only Email
;   channel=webhook        -> only webhook
;   channel=discord,email,webhook  -> both
channel=webhook

; --- Discord channel ---
; Webhook URL (required when 'discord' is in channel and for flag webhook if error)
discord_webhook_url=

; --- webhook channel ---
; Webhook URL (required when 'webhook' is in channel)
webhook_url=

; --- Email channel ---
; Recipient address(es), comma separated (required when 'email' is in channel)
; The SMTP sender account is configured in the [email] section below
email_to=

[email]
; SMTP sender settings, used when the 'email' channel is enabled above.
; Display name shown as the sender
name=Bqckup
; Sender address / SMTP username
email=
; SMTP password. Leave empty for servers that need no authentication (e.g. local Mailpit/Mailhog)
password=
; SMTP host and port (Gmail: smtp.gmail.com / 587, local Mailpit: 127.0.0.1 / 1025)
host=smtp.gmail.com
port=587
; Encryption: tls, ssl, or leave empty for none
encryption=tls

[webhooks]
after_backup_completed=

[master]
url=
